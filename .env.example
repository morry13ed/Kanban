# Copy to .env.local for local development, and set the same two values as
# Environment Variables in the Vercel project for production.
# Both come from Supabase: Project Settings -> API.
# Without them the app silently falls back to localStorage only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
